# Supabase PostgreSQL connection (Session Pooler, port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:6543/postgres

# Direct connection for migrations (port 5432)
DATABASE_URL_DIRECT=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<DIRECT_HOST>:5432/postgres

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Environment
ENVIRONMENT=development

# NASA FIRMS Map Key — obtain from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

# Number of past days per FIRMS ingestion request (1–10, NASA API limit)
# Phase 5D default: 5 days for broader temporal coverage
FIRMS_INGESTION_DAYS=7

# Comma-separated list of FIRMS satellite data sources to ingest
# Phase 5D: all three operational VIIRS NRT satellites for maximum India-wide coverage
# Available: VIIRS_SNPP_NRT, VIIRS_NOAA20_NRT, VIIRS_NOAA21_NRT, MODIS_NRT
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT
