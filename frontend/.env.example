# ThermalTrace Frontend Environment Configuration Template (Vercel / Vite)
# Note: Only browser-safe, public variables starting with VITE_ should be defined here.
# NEVER include backend secrets (DATABASE_URL, REDIS_URL, GEMINI_API_KEY, FIRMS_MAP_KEY, SUPABASE_SERVICE_ROLE_KEY).

# Target FastAPI Backend API Base URL
VITE_API_URL=https://your-api-domain.onrender.com

# Supabase Project Public Configuration (Browser Safe)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Thunderforest Basemap Tile API Key (Optional)
VITE_THUNDERFOREST_API_KEY=your_thunderforest_api_key_here
